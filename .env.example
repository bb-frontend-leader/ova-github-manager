# Copia este archivo a .env.local y rellena los valores. Nunca lo subas a git.

# --- GitHub ---
# Un solo token para TODAS las organizaciones (debe tener acceso a cada una).
# Fase actual: token personal con permisos de administración de repos y teams.
# Se reemplazará por una GitHub App (ver README).
GITHUB_TOKEN=your_personal_access_token_here

# --- Login con GitHub (Auth.js) ---
# OAuth App creada EN LA ORGANIZACIÓN (ver README). Callback:
#   http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your_oauth_app_client_id
AUTH_GITHUB_SECRET=your_oauth_app_client_secret

# Secreto para firmar las sesiones. Genera uno con:  npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=generate_a_long_random_secret

# Necesario al ejecutar en un servidor propio (fuera de Vercel)
AUTH_TRUST_HOST=true

# Dominio público (SOLO el origen, sin la ruta: la ruta sale de BASE_PATH). Opcional si el proxy
# envía bien los encabezados Host / X-Forwarded-*.
# AUTH_URL=https://www.tu-dominio.com

# --- Puerto ---
# Puerto en el que escucha `npm run dev` / `npm start` (por defecto 3000).
# Si lo cambias, actualiza también las URL de la OAuth App (Homepage y callback).
# PORT=3000

# --- Despliegue bajo una ruta ---
# Si no vive en la raíz del dominio, indica la ruta (con / al inicio y sin / al final).
# Ponlo en .env.local: se lee al compilar Y al arrancar. Si lo cambias, vuelve a ejecutar `npm run build`.
# El callback de la OAuth App pasa a ser:  https://www.tu-dominio.com<BASE_PATH>/api/auth/callback/github
# BASE_PATH=/ova-github-manager/app

# --- Acceso ---
# Super administradores (separados por comas): crean proyectos y son admin en todos.
# Sirve de arranque y de recuperación: si se pierde el acceso, añade un usuario aquí
# y vuelve a iniciar sesión.
INITIAL_ADMINS=your_github_username

# --- Datos ---
DATABASE_PATH=./data/ova.db

# --- Copias de seguridad de la base de datos ---
# Se copia sola (con la herramienta en uso) y se conservan solo las más recientes.
# Carpeta de las copias. Por defecto, "backups" junto a la base. Mejor en otro disco o en una
# carpeta que ya se respalde fuera del servidor.
# BACKUP_DIR=./data/backups
# Cada cuántas horas se hace una copia automática (24 por defecto; 0 = sin copias automáticas).
# BACKUP_INTERVAL_HOURS=24
# Cuántas copias se conservan (14 por defecto).
# BACKUP_KEEP=14

# --- Solo para migrar una base de la versión de UN solo proyecto ---
# Si la base ya existe de antes, estos valores pasan a ser el primer proyecto (se hace una copia
# de seguridad en data/ova.db.pre-projects.bak). Después los proyectos se gestionan desde la
# interfaz y estas variables dejan de usarse. En una instalación nueva no hacen falta.
# GITHUB_ORG=your_organization_name_here
# OVA_DESCRIPTION_PREFIX=625 OVAs 2027
# OVA_DEFAULT_TEAM=Frontend
# OVA_TEMPLATE=ova-template
# OVA_TOTAL=625
