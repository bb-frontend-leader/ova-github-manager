# Copia este archivo a .env.local y rellena los valores. Nunca lo subas a git.

# --- GitHub ---
# Organización donde se crean las OVAs
GITHUB_ORG=your_organization_name_here

# Fase actual: token personal con permisos de administración de repos y teams.
# Se reemplazará por una GitHub App (ver README).
GITHUB_TOKEN=your_personal_access_token_here

# --- Login con GitHub (Auth.js) ---
# OAuth App creada EN LA ORGANIZACIÓN (ver README). Callback:
#   http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your_oauth_app_client_id
AUTH_GITHUB_SECRET=your_oauth_app_client_secret

# Secreto para firmar las sesiones. Genera uno con:  npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=generate_a_long_random_secret

# Necesario al ejecutar en un servidor propio (fuera de Vercel)
AUTH_TRUST_HOST=true

# --- Acceso ---
# Usuarios de GitHub que SIEMPRE son admin (separados por comas).
# Sirve de arranque y de recuperación: si se pierde el acceso de admin,
# añade un usuario aquí y vuelve a iniciar sesión.
INITIAL_ADMINS=your_github_username

# --- Datos y proyecto (opcionales; estos son los valores por defecto) ---
DATABASE_PATH=./data/ova.db
OVA_DESCRIPTION_PREFIX=625 OVAs 2027
OVA_DEFAULT_TEAM=Frontend
# Repositorio plantilla de la organización desde el que se crea cada OVA.
# Debe estar marcado como "Template repository" en GitHub (Settings > Template repository).
OVA_TEMPLATE=ova-template
OVA_TOTAL=625
